OBSIDIAN_VAULT_PATH="/srv/obsidian-webdav/Knowledge Graph"
OBSIDIAN_BACKUP_PATH=/var/lib/obsidian-mcp/backups
# Recovery copies kept per note and maximum age in days (defaults 20 and 90).
OBSIDIAN_BACKUP_KEEP=20
OBSIDIAN_BACKUP_DAYS=90
# Snapshot for the DOI MCP maps (notes.json) and the Zotero library snapshot read for ANZSRC codes.
KNOWLEDGE_DIR=/var/lib/knowledge
# Rewrite notes.json a few seconds after every write (default on).
KNOWLEDGE_AUTO_REFRESH=true
PORT=3004
PUBLIC_HOSTNAME=your-host.your-tailnet.ts.net
MCP_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
OAUTH_ISSUER=https://your-host.your-tailnet.ts.net/obsidian-auth
PUBLIC_MCP_URL=https://your-host.your-tailnet.ts.net/obsidian-mcp
OAUTH_STATE_PATH=/var/lib/obsidian-mcp/oauth
OAUTH_PASSWORD_HASH=